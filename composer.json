{
	"name": "quorum/stream-functions",
	"description": "useful php-stream resource handling functions for common lexing and parsing tasks",
	"keywords": [
		"lexing",
		"parsing",
		"stream"
	],
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "Jesse Donat",
			"email": "donatj@gmail.com"
		}
	],
	"require": {
		"php": "^7.4|^8.0"
	},
	"require-dev": {
		"donatj/mddoc": "^0.11.1",
		"phpstan/phpstan": "^2.2",
		"phpunit/phpunit": "^9.6"
	},
	"autoload": {
		"files": [
			"src/streams.php"
		]
	},
	"config": {
		"sort-packages": true
	}
}
